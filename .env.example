# Copy to .env for local runs. Never commit .env. Values here are examples or empty.

# Postgres connection string. Supabase: Connect -> "Session pooler", then add
# ?sslmode=require at the end. See README "Supabase".
DATABASE_URL=
# 0 = no prepared-statement cache; needed for poolers like PgBouncer, harmless otherwise.
DB_STATEMENT_CACHE_SIZE=0

# The Odds API key. Set it in Railway's variables, never in code or git.
ODDS_API_KEY=
# 1 = use recorded/synthetic responses, spend nothing.
ODDS_API_MOCK=0
# ODDS_API_BASE_URL=https://api.the-odds-api.com
# ODDS_API_TIMEOUT_S=30

# Credit budget.
MONTHLY_CREDIT_LIMIT=500
CREDIT_RESERVE=50
CREDIT_PAUSE_PCT=90
# PENDING_STALE_MINUTES=5

# Comma-separated; up to 10 bookmakers cost 1 credit per market per league refresh.
# DEFAULT_BOOKMAKERS=pinnacle,betfair_ex_eu,matchbook,smarkets,onexbet,marathonbet,williamhill,unibet_uk,betway,betvictor
# DEFAULT_MARKETS=h2h
# SCHEDULE_PRESET=balanced   # lean | balanced | dense

# Database size guard (Supabase free tier = 500 MB).
# DB_LIMIT_MB=500
# DB_WARN_PCT=80
# DB_CRITICAL_PCT=90
# DB_PAUSE_PCT=95

# Login for the whole site (browser prompt). Strongly recommended on a public URL.
APP_USER=sharp
APP_PASSWORD=

# Background poller (runs inside the web process).
# POLLER_ENABLED=1
# POLL_TICK_SECONDS=30

PORT=8000
